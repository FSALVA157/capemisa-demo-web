VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# URL del webhook del chat web (workflow n8n `capemisa_conversacional_web`).
# Si falta, el chat no se monta y el resto de la web funciona igual: a diferencia
# de las dos variables de arriba, esta no es obligatoria para que la app arranque.
#
# En Coolify hay que marcarla como **Build Variable**, no solo como variable de
# runtime: las VITE_* se inlinean en tiempo de build. Marcarla solo como runtime
# hace que en local ande perfecto y en producción el chat no aparezca nunca.
VITE_N8N_CHAT_URL=
